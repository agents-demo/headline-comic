# Add keys here in your local .env file. Never commit .env.
TAVILY_API_KEY=

# T002/T012-T016: only needed when we approve a real LLM call.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# T028: narration text-to-speech (Fish Audio free model).
FISH_API_KEY=
FISH_BASE_URL=https://api.fish.audio/v1/tts
# FISH_MODEL=s2.1-pro-free       # free model, sent as an HTTP header
# FISH_REFERENCE_ID=             # optional voice; omit for the default voice
# FISH_FORMAT=mp3                # mp3

# T043: MiniMax-H3 video via self-hosted vLLM-Omni (no API key; $0 per call).
# Point at the presenter's GPU server. If it sits behind HTTP Basic auth, either
# embed the credentials in the URL (userinfo) ...
#   MINIMAX_H3_BASE_URL=http://batya:CODE@10.10.12.102:8000
# ... or keep the URL clean and set them separately:
MINIMAX_H3_BASE_URL=http://10.10.12.102:8000
# MINIMAX_H3_USERNAME=batya
# MINIMAX_H3_PASSWORD=
# MINIMAX_H3_VARIANT=fl2va       # fl2va | ref2va
# MINIMAX_H3_WIDTH=1024          # 16:9, multiple of 32 (A6000-safe)
# MINIMAX_H3_HEIGHT=576
# MINIMAX_H3_ASPECT_RATIO=16:9
# MINIMAX_H3_NUM_INFERENCE_STEPS=50
# MINIMAX_H3_FLOW_SHIFT=12.0
# MINIMAX_H3_AUDIO_FLOW_SHIFT=3.0
# MINIMAX_H3_FPS=24

# T043 (reserved future gate): MiniMax-hosted cloud API (paid — not wired yet).
# MINIMAX_H3_API_URL=
# MINIMAX_H3_API_KEY=
