.env
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
logs/
*.py[cod]

# Runtime artifacts and local generated media
runs/*
!runs/.gitkeep
demo/*
!demo/.gitkeep

# Optional local source checkouts used by the AniDoodle/FFmpeg spike
/anidoodle/
/ffmpeg/

assets/cast/*
!assets/cast/.gitkeep
assets/music/*
!assets/music/.gitkeep

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# Node artifact (npm install lockfile; the project's Node tooling is vendored under scripts/)
package-lock.json
