{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://headline-comic.local/schemas/run-manifest.schema.json",
  "title": "Run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "created_at", "status", "artifacts"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["running", "awaiting_approval", "complete", "failed"]},
    "artifacts": {
      "type": "object",
      "description": "Paths are relative to this run's directory; application code enforces that writes stay inside runs/.",
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
      "additionalProperties": {"type": "string", "minLength": 1}
    }
  }
}