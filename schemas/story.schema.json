{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://headline-comic.local/schemas/story.schema.json",
  "title": "Six-beat fictional story",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "title", "fiction_label", "characters", "beats"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "title": {"type": "string", "minLength": 1},
    "fiction_label": {"const": "Fiction inspired by today's news"},
    "characters": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"}},
    "beats": {"type": "array", "minItems": 6, "maxItems": 6, "prefixItems": [
      {"$ref": "#/$defs/intro"},
      {"$ref": "#/$defs/beat1"},
      {"$ref": "#/$defs/beat2"},
      {"$ref": "#/$defs/beat3"},
      {"$ref": "#/$defs/beat4"},
      {"$ref": "#/$defs/beat5"}
    ], "items": false}
  },
  "$defs": {
    "beat_base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["beat_index", "source_ref", "text"],
      "properties": {
        "beat_index": {"type": "integer", "minimum": 0, "maximum": 5},
        "source_ref": {"type": "integer", "minimum": 0, "maximum": 5},
        "text": {"type": "string", "minLength": 1},
        "ending": {"type": "boolean"}
      }
    },
    "intro": {"allOf": [{"$ref": "#/$defs/beat_base"}, {"properties": {"beat_index": {"const": 0}, "source_ref": {"const": 0}}}]},
    "beat1": {"allOf": [{"$ref": "#/$defs/beat_base"}, {"properties": {"beat_index": {"const": 1}, "source_ref": {"const": 1}}}]},
    "beat2": {"allOf": [{"$ref": "#/$defs/beat_base"}, {"properties": {"beat_index": {"const": 2}, "source_ref": {"const": 2}}}]},
    "beat3": {"allOf": [{"$ref": "#/$defs/beat_base"}, {"properties": {"beat_index": {"const": 3}, "source_ref": {"const": 3}}}]},
    "beat4": {"allOf": [{"$ref": "#/$defs/beat_base"}, {"properties": {"beat_index": {"const": 4}, "source_ref": {"const": 4}}}]},
    "beat5": {"allOf": [{"$ref": "#/$defs/beat_base"}, {"properties": {"beat_index": {"const": 5}, "source_ref": {"const": 5}, "ending": {"const": true}}, "required": ["ending"]}]}
  }
}